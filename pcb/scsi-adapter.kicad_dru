(version 1)
# JLCPCB 4-layer rules that Board Setup > Constraints can't express on its own.
# Source: jlcpcb.com/capabilities/pcb-capabilities (read 2026-09-26). Global minimums
# (0.1 mm track/space, 0.3/0.5 mm via, 0.3 mm to edge) live in Board Setup.

(rule "JLC: PTH annular ring 0.15 mm min (0.20 recommended)"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm)))

(rule "JLC: pad hole to pad hole 0.45 mm"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

(rule "JLC: NPTH 0.5 mm min"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))

(rule "JLC: SMD pad to pad 0.15 mm (different nets)"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net")
	(constraint clearance (min 0.15mm)))

(rule "JLC: PTH to track 0.28 mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
	(constraint hole_clearance (min 0.28mm)))

(rule "JLC: silkscreen text 1.0 mm tall, 0.15 mm stroke"
	(layer "?.Silkscreen")
	(condition "A.Type == 'Text' || A.Type == 'Field'")
	(constraint text_height (min 1.0mm))
	(constraint text_thickness (min 0.15mm)))
