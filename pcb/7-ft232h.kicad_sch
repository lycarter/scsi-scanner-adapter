	(text "ACBUS5/6/8/9: free (CBUS bit-bang possible later). ACBUS7 = PWRSAV#: leave\nopen, with 'Suspend on ACBus7 Low' OFF in the EEPROM. TEST (42) to GND." (exclude_from_sim no) (at 165.1 129.54 0) (effects (font (size 1.016 1.016) (italic yes)) (justify left top)) (uuid "df81d290-7b2a-5d50-9e9e-a5c17bdd5c26"))
	(rectangle (start 246.38 12.7) (end 406.4 157.48) (stroke (width 0.254) (type dash)) (fill (type none)) (uuid "77c4e3b8-5b12-5c4d-9eed-ed81362f8aea"))
	(text "Power (DS Fig. 6.2, exactly)" (exclude_from_sim no) (at 254 20.32 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "e9d470a8-96db-52d5-b5c6-9c2f55d532df"))
	(text "VREGIN from +5V_SYS. VCCD is then an OUTPUT: the chip's own 3.3 V\n(FT232H_3V3), feeding VCCIO x3, VPHY and VPLL (through 600R ferrites)\nand the EEPROM. Never connect FT232H_3V3 to the board's +3V3." (exclude_from_sim no) (at 254 24.82 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "3a8f9875-1881-5790-b14b-d41148d9832e"))
