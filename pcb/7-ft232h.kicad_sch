	(text "FT232H (USB 2.0 high speed <-> FT1248)" (exclude_from_sim no) (at 20.32 20.32 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "ddd94dcb-cf41-5012-bb60-692e6006ad28"))
	(text "FT1248 4-bit to the RP2350 (MIOSIO0-3, SCLK, SS_N, MISO; 33R series at the RP2350 end). The EEPROM selects\nFT1248 mode: without it the chip starts in UART mode. D4-D7 and WR# only reach the RP2350 through the\nunfitted rework links (245-FIFO fallback). SCLK/SS_N/MISO sit on the FIFO's RXF#/TXE#/RD# pins." (exclude_from_sim no) (at 20.32 24.82 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "92194862-39a3-5421-a8a9-983d71f4004a"))
