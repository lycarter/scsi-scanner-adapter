	(text "1k: ~1.3 mA red/yellow. Green (KT-0805G, Vf 2.6-3.1 V at 5 mA) gets 470R: ~2.4 V at\nlow current, so ~1.8 mA typical, >= ~0.7 mA at the top of the Vf spread." (exclude_from_sim no) (at 20.32 269.24 0) (effects (font (size 1.016 1.016) (italic yes)) (justify left top)) (uuid "db17c70b-80a7-5c72-accb-a19785a6f69c"))
