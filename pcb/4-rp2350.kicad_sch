	(text "RP2350B" (exclude_from_sim no) (at 167.64 20.32 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left top)) (uuid "c6c77cc7-defd-5201-93be-0cd03ede5e3a"))
	(text "Pin map: blocks/5-rp2350-pinout.md. GPIO 0-17 = receiver outputs (PIO0 in, read inverted),\nGPIO 18-31 = driver gates (1 = asserted). The only ground is the exposed pad (pin 81).\nSeries resistors sit at the pins: 33R on the 7 FT1248 nets (damps ringing at 25 MHz, limits\ncontention), 100R on the logic-analyzer markers, 27R 0603 on native USB (close to the chip)." (exclude_from_sim no) (at 167.64 24.82 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "24bbcdd5-d18c-5388-ae42-95e81f2743a6"))
